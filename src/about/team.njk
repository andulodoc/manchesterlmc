---
layout: layouts/base.njk
title: LMC Officers and Executive
description: "Meet the Manchester LMC team — our elected committee members, officers, and administrative staff."
mainClass: page-team
showDisclaimer: true
permalink: /about/team/
---

  <section class="page-hero" aria-label="Page header">
    <div class="container">
      <div class="page-hero-content">
        {% set breadcrumbs = [{url: "/about/", label: "About Us"}, {label: "LMC Officers and Executive"}] %}
        {% include "partials/breadcrumb.njk" %}
        <h1>LMC Officers and Executive</h1>
        <p>Manchester LMC is led by elected GP representatives and supported by a dedicated administrative team</p>
      </div>
    </div>
  </section>

  <!-- Executive officers -->
  <section class="section" aria-labelledby="officers-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Leadership</span>
        <h2 id="officers-heading">Executive Officers</h2>
        <p>Our officers and executive are elected by the LMC committee and serve in these roles alongside their clinical work.</p>
      </div>

      <div class="grid-3">
        {% for person in collections.officers %}
          {% include "partials/person-card.njk" %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Committee members -->
  <section class="section section--neutral" aria-labelledby="committee-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Elected Members</span>
        <h2 id="committee-heading">LMC Committee Members</h2>
        <p>In addition to the LMC Executive and Officers above, our wider committee is elected by the GPs they represent — partners, salaried GPs, and freelance GPs from across Manchester.</p>
      </div>

      {% set groups = [
        { members: committeeMembers.partners, label: "Partners" },
        { members: committeeMembers.salaried, label: "Salaried GPs" },
        { members: committeeMembers.freelance, label: "Freelance GPs" }
      ] %}

      {% for grp in groups %}
        <div style="margin-bottom:var(--space-10);">
          <h3 style="margin-bottom:var(--space-4);">{{ grp.label }} ({{ grp.members | length }})</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:var(--space-3);">
            {% for member in grp.members %}
              <div style="border:1px solid var(--colour-border);border-radius:var(--radius-md);padding:var(--space-4);">
                <p style="font-weight:600;color:var(--colour-primary);margin-bottom:var(--space-1);">{{ member.name }}</p>
                <p style="font-size:.875rem;color:var(--colour-muted);margin-bottom:2px;">{{ member.constituency }}</p>
                <p style="font-size:.875rem;color:var(--colour-muted);">{{ member.practice }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endfor %}

      <div class="alert alert--info">
        <strong>Note:</strong> Committee member names, constituencies, and practices shown above are placeholders and will be updated once confirmed.
      </div>
    </div>
  </section>

  <!-- Admin team -->
  <section class="section" aria-labelledby="admin-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Administration</span>
        <h2 id="admin-heading">Administrative Staff</h2>
        <p>Our administrative team ensures the day-to-day operation of the LMC — from managing member enquiries to organising meetings and maintaining resources.</p>
      </div>

      <div class="grid-3">
        {% for person in collections.adminStaff %}
          {% include "partials/person-card.njk" %}
        {% endfor %}
      </div>

      <div class="alert alert--info" style="margin-top:var(--space-8);">
        <strong>Note:</strong> Staff photographs and full biographies will be added once approved by each individual. Placeholder names marked [Name] will be updated prior to launch. Contact <a href="mailto:enquiries@manchesterlmc.co.uk">enquiries@manchesterlmc.co.uk</a> for any urgent enquiries.
      </div>

    </div>
  </section>

  <!-- Get involved -->
  <section class="section section--primary" aria-label="Get involved">
    <div class="container" style="text-align:center;">
      <span class="section-eyebrow">Join Us</span>
      <h2 style="margin-bottom:var(--space-5);">Interested in Joining the LMC?</h2>
      <p style="color:rgba(255,255,255,.78);max-width:52ch;margin:0 auto var(--space-8);">Committee vacancies are filled by election. If you are a GP practising in Manchester and would like to represent your colleagues, we would love to hear from you.</p>
      <a href="/contact/" class="btn btn--primary btn--lg">Get in touch</a>
    </div>
  </section>
