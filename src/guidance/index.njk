---
layout: layouts/base.njk
title: Resource Library
description: "Searchable guidance, policies, and clinical resources for Manchester GPs and practice staff."
mainClass: page-content
showContactStrip: true
showDisclaimer: true
---

  <section class="page-hero" aria-label="Page header">
    <div class="container">
      <div class="page-hero-content">
        {% set breadcrumbs = [{label: "Guidance Library"}] %}
        {% include "partials/breadcrumb.njk" %}
        <h1>Resource Library</h1>
        <p>Searchable guidance, policies, and clinical resources for Manchester GPs and practice staff</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="library-heading">
    <div class="container">

      <div id="guidance-filter" class="filter-bar" role="search" aria-label="Filter documents">
        <div class="filter-search">
          <div class="filter-search-input-wrap">
            <svg class="filter-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input class="filter-search-input" type="search" placeholder="Search documents…" aria-label="Search documents">
          </div>
        </div>
        <div class="filter-chips" role="group" aria-label="Filter by category">
          <button class="filter-chip active" data-category="all" aria-pressed="true">All</button>
          <button class="filter-chip" data-category="clinical" aria-pressed="false">Clinical</button>
          <button class="filter-chip" data-category="contractual" aria-pressed="false">Contractual</button>
          <button class="filter-chip" data-category="cqc" aria-pressed="false">CQC</button>
          <button class="filter-chip" data-category="legal" aria-pressed="false">Legal</button>
          <button class="filter-chip" data-category="prescribing" aria-pressed="false">Prescribing</button>
          <button class="filter-chip" data-category="workforce" aria-pressed="false">Workforce</button>
          <button class="filter-chip" data-category="covid" aria-pressed="false">COVID / Pandemic</button>
          <button class="filter-chip" data-category="collective-action" aria-pressed="false">Collective Action</button>
        </div>
      </div>

      <p id="results-count" class="filter-results-count" aria-live="polite" aria-atomic="true">Showing {{ collections.guidance.length }} documents</p>

      <div id="document-list" role="list" aria-label="Document library">

        {% for doc in collections.guidance %}
        <div class="doc-card" role="listitem" data-doc data-category="{{ doc.data.category }}" data-title="{{ doc.data.title | lower }}">
          <div class="doc-card-icon doc-card-icon--{{ doc.data.fileType }}" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div class="doc-card-body">
            <div class="doc-card-meta"><span class="badge {{ doc.data.category | guidanceBadgeClass }}">{{ doc.data.category | guidanceCategoryName }}</span><span class="doc-card-date">{{ doc.date | dateMonthYear }}</span></div>
            <h3 class="doc-card-title">{{ doc.data.title }}</h3>
          </div>
          <div class="doc-card-actions">
            <a href="{{ doc.data.downloadUrl }}" class="btn btn--sm btn--outline" aria-label="Download {{ doc.data.title }} ({% if doc.data.fileType === 'word' %}Word{% else %}PDF{% endif %})" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {% if doc.data.fileType === "word" %}Word{% else %}PDF{% endif %}
            </a>
          </div>
        </div>
        {% endfor %}

      </div><!-- /document-list -->

    </div>
  </section>
