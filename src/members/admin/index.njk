---
layout: layouts/base.njk
title: Admin Dashboard
description: "Manchester LMC admin — manage member accounts and view audit log."
mainClass: page-members
showContactStrip: false
showDisclaimer: false
---

<section class="page-hero">
  <div class="container">
    {% set breadcrumbs = [{label: "Members Area", url: "/members/"}, {label: "Admin Dashboard"}] %}
    {% include "partials/breadcrumb.njk" %}
    <h1>Admin Dashboard</h1>
    <p>Manage member accounts, approve registrations, and review security events.</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <!-- Access denied (shown if not lmc_admin) -->
    <div id="admin-access-denied" style="display:none; max-width:520px; margin:0 auto; text-align:center;">
      <div class="alert alert--warning">
        {% icon "lock", 20 %}
        <div>You do not have permission to access this page. <a href="/members/">Return to Members Area</a>.</div>
      </div>
    </div>

    <!-- Loading state -->
    <div id="admin-loading" style="text-align:center; padding:3rem 0; color:var(--colour-muted);">
      {% icon "loader", 24 %}
      <p style="margin-top:1rem;">Loading…</p>
    </div>

    <!-- Dashboard content (shown when authenticated as admin) -->
    <div id="admin-content" style="display:none;">

      <!-- Stats bar -->
      <div class="grid-3" style="gap:1rem; margin-bottom:2.5rem;" id="admin-stats">
        <div class="card" style="padding:1.25rem; text-align:center;">
          <div style="font-size:2rem; font-weight:700; color:var(--colour-accent);" id="stat-pending">—</div>
          <div style="font-size:0.875rem; color:var(--colour-muted);">Pending Approval</div>
        </div>
        <div class="card" style="padding:1.25rem; text-align:center;">
          <div style="font-size:2rem; font-weight:700; color:var(--colour-primary);" id="stat-active">—</div>
          <div style="font-size:0.875rem; color:var(--colour-muted);">Active Members</div>
        </div>
        <div class="card" style="padding:1.25rem; text-align:center;">
          <div style="font-size:2rem; font-weight:700; color:var(--colour-muted);" id="stat-suspended">—</div>
          <div style="font-size:0.875rem; color:var(--colour-muted);">Suspended</div>
        </div>
      </div>

      <!-- Tabs -->
      <div role="tablist" aria-label="Admin sections" style="display:flex; gap:0; border-bottom:2px solid var(--colour-border); margin-bottom:0;">
        <button role="tab" aria-selected="true"  aria-controls="panel-pending"  id="tab-pending"  data-admin-tab="pending"
          style="padding:0.75rem 1.5rem; border:none; background:none; cursor:pointer; font-size:0.95rem; font-weight:600; color:var(--colour-primary); border-bottom:3px solid var(--colour-primary); margin-bottom:-2px;">
          Pending <span id="pending-badge" class="badge badge--accent" style="margin-left:0.4rem; display:none;"></span>
        </button>
        <button role="tab" aria-selected="false" aria-controls="panel-members" id="tab-members" data-admin-tab="members"
          style="padding:0.75rem 1.5rem; border:none; background:none; cursor:pointer; font-size:0.95rem; color:var(--colour-muted); border-bottom:3px solid transparent; margin-bottom:-2px;">
          All Members
        </button>
        <button role="tab" aria-selected="false" aria-controls="panel-audit"   id="tab-audit"   data-admin-tab="audit"
          style="padding:0.75rem 1.5rem; border:none; background:none; cursor:pointer; font-size:0.95rem; color:var(--colour-muted); border-bottom:3px solid transparent; margin-bottom:-2px;">
          Audit Log
        </button>
      </div>

      <!-- Pending approvals panel -->
      <div id="panel-pending" role="tabpanel" aria-labelledby="tab-pending" class="card" style="padding:1.5rem; border-top:none; border-radius:0 0 8px 8px;">
        <p style="color:var(--colour-muted); font-size:0.9rem; margin:0 0 1.5rem;">
          These accounts have registered but are awaiting your approval (and payment confirmation for locum subscribers).
        </p>
        <div id="pending-list">
          <p style="color:var(--colour-muted);">Loading…</p>
        </div>
      </div>

      <!-- All members panel -->
      <div id="panel-members" role="tabpanel" aria-labelledby="tab-members" class="card" style="display:none; padding:1.5rem; border-top:none; border-radius:0 0 8px 8px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:0.75rem;">
          <input type="search" id="member-search" class="form-input" placeholder="Search by name or email…"
                 style="max-width:320px;" aria-label="Search members">
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <button class="btn btn--sm btn--outline member-filter-btn active" data-filter="all">All</button>
            <button class="btn btn--sm btn--outline member-filter-btn" data-filter="active">Active</button>
            <button class="btn btn--sm btn--outline member-filter-btn" data-filter="pending">Pending</button>
            <button class="btn btn--sm btn--outline member-filter-btn" data-filter="suspended">Suspended</button>
          </div>
        </div>
        <div id="members-list">
          <p style="color:var(--colour-muted);">Loading…</p>
        </div>
      </div>

      <!-- Audit log panel -->
      <div id="panel-audit" role="tabpanel" aria-labelledby="tab-audit" class="card" style="display:none; padding:1.5rem; border-top:none; border-radius:0 0 8px 8px;">
        <p style="color:var(--colour-muted); font-size:0.9rem; margin:0 0 1.5rem;">
          Most recent 100 security events. IP addresses are hashed for privacy.
        </p>
        <div id="audit-list">
          <p style="color:var(--colour-muted);">Loading…</p>
        </div>
      </div>

    </div><!-- /admin-content -->

  </div>
</section>

<script src="/assets/js/admin.js"></script>
