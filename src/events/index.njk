---
layout: layouts/base.njk
title: "Events & Meetings"
description: "Upcoming events, meetings, and educational sessions from Manchester LMC."
mainClass: page-events
showDisclaimer: true
---

  <!-- Hero -->
  <section class="page-hero" aria-label="Page header">
    <div class="container">
      <div class="page-hero-content">
        {% set breadcrumbs = [{label: "Events & Meetings"}] %}
        {% include "partials/breadcrumb.njk" %}
        <h1>Events &amp; Meetings</h1>
        <p>Upcoming LMC meetings, educational events, and external sessions for Manchester GPs and practice staff</p>
      </div>
    </div>
  </section>

  {# ── Upcoming events ── #}
  <section class="section" aria-labelledby="upcoming-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">What's On</span>
        <h2 id="upcoming-heading">Upcoming Events</h2>
      </div>

      <div style="display:flex;flex-direction:column;gap:var(--space-4);">
        {% for event in collections.upcomingEvents %}
        <div class="event-item">
          <div class="event-date-badge">
            <span class="event-date-day">{{ event.date | dateDay }}</span>
            <span class="event-date-month">{{ event.date | dateMonthShort }}</span>
          </div>
          <div class="event-content">
            <h3>{{ event.data.title }}</h3>
            <div class="event-meta">
              <span class="event-meta-item">
                {% icon "clock" %}
                {{ event.data.time }}
              </span>
              <span class="event-meta-item">
                {% if event.data.format == "online" %}
                {% icon "monitor" %}
                {% else %}
                {% icon "map-pin" %}
                {% endif %}
                {{ event.data.venue }}
              </span>
              <span class="badge {{ event.data.audience | audienceBadgeClass }}">{{ event.data.audience | audienceLabel }}</span>
            </div>
            <p class="event-desc">{{ event.data.description }}</p>
          </div>
          {% if event.data.registerUrl %}
          <a href="{{ event.data.registerUrl }}" class="btn btn--outline btn--sm" style="flex-shrink:0;align-self:center;">{{ event.data.registerLabel or "Register" }}</a>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ── Meeting calendar tabs ── #}
  <section class="section section--neutral" id="meetings" aria-labelledby="meetings-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">2026 Meeting Dates</span>
        <h2 id="meetings-heading">LMC Meeting Calendar</h2>
        <p>All LMC meetings are open to the constituency they serve. Agendas and papers are circulated to members in advance via the subscriber area.</p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Meeting types">
          <button class="tab-btn" role="tab" data-tab="tab-partners" aria-selected="false">
            {% icon "briefcase", 16 %}
            Partner &amp; Salaried GP Meetings
          </button>
          <button class="tab-btn" role="tab" data-tab="tab-locum" aria-selected="false">
            {% icon "users", 16 %}
            Locum &amp; Freelance Meetings
          </button>
          <button class="tab-btn" role="tab" data-tab="tab-external" aria-selected="false">
            {% icon "globe", 16 %}
            External &amp; Educational Events
          </button>
        </div>

        {# Macro: renders a meeting-date table for a given audience #}
        {% macro meetingTable(audience, columns) %}
          <div style="overflow-x:auto;margin-top:var(--space-6);">
            <table style="width:100%;border-collapse:collapse;font-size:.9375rem;">
              <thead>
                <tr style="border-bottom:2px solid var(--colour-border);">
                  {% for col in columns %}
                  <th style="text-align:left;padding:var(--space-3) var(--space-4);color:var(--colour-muted);font-weight:600;font-size:.8125rem;text-transform:uppercase;letter-spacing:.06em;">{{ col }}</th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in collections.meetingDates %}
                {% if row.data.audience == audience %}
                <tr style="border-bottom:1px solid var(--colour-border);">
                  <td style="padding:var(--space-4);font-weight:600;color:var(--colour-primary);">{{ row.date | dateFull }}</td>
                  <td style="padding:var(--space-4);color:var(--colour-muted);">{{ row.data.time or "TBC" }}</td>
                  <td style="padding:var(--space-4);">{{ row.data.venue }}</td>
                  <td style="padding:var(--space-4);">
                    {% if row.data.registerUrl %}
                    <a href="{{ row.data.registerUrl }}" class="link-arrow" style="font-size:.875rem;">{{ row.data.registerLabel }}{% icon "arrow-right" %}</a>
                    {% else %}
                    <span style="color:var(--colour-muted);">TBC</span>
                    {% endif %}
                  </td>
                </tr>
                {% endif %}
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endmacro %}

        <div class="tab-panel" id="tab-partners" role="tabpanel" hidden>
          {{ meetingTable("partners-salaried", ["Date", "Time", "Venue", "Papers"]) }}
        </div>

        <div class="tab-panel" id="tab-locum" role="tabpanel" hidden>
          {{ meetingTable("locum", ["Date", "Time", "Format", "Join"]) }}
          <div class="alert alert--info" style="margin-top:var(--space-6);">
            Locum GP meetings are open to all locums in the Manchester area — no prior registration needed. Join link sent to subscribers; non-subscribers contact <a href="mailto:enquiries@manchesterlmc.co.uk">enquiries@manchesterlmc.co.uk</a>.
          </div>
        </div>

        <div class="tab-panel" id="tab-external" role="tabpanel" hidden>
          {{ meetingTable("external", ["Date", "Time", "Venue", "Link"]) }}
        </div>

      </div><!-- /tabs -->
    </div>
  </section>

  {# ── Past meeting minutes ── #}
  <section class="section" aria-labelledby="minutes-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Archive</span>
        <h2 id="minutes-heading">Past Meeting Minutes</h2>
        <p>Minutes from recent LMC meetings are available to subscribers in the Members Area. A selection of older minutes is publicly available below.</p>
      </div>

      <div class="accordion">
        {% for group in collections.pastMinutes | groupByYear %}
        <details class="accordion-item">
          <summary class="accordion-btn">
            {{ group.year }} Partners Meeting Minutes
            <span class="accordion-icon">{% icon "chevron-down" %}</span>
          </summary>
          <div class="accordion-panel">
            <ul style="list-style:none;display:flex;flex-direction:column;gap:var(--space-3);">
              {% for item in group.items %}
              <li style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-3) 0;{% if not loop.last %}border-bottom:1px solid var(--colour-border);{% endif %}">
                <span>{{ item.data.title }}</span>
                <a href="{{ item.data.downloadUrl }}" class="btn btn--sm btn--outline">Download PDF</a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </details>
        {% endfor %}
      </div><!-- /accordion -->

      <div class="alert alert--info" style="margin-top:var(--space-8);">
        <strong>Members:</strong> Full minutes, agendas, and supporting papers for all 2025–26 meetings are available in the <a href="/members/">Subscriber Area</a>.
      </div>

    </div>
  </section>
