<section class="section section--neutral">
  <div class="container" style="max-width:760px;">
    {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
    <div class="accordion">
      {% for item in section.items %}
      <details class="accordion-item">
        <summary class="accordion-btn">
          {{ item.q }}
          <span class="accordion-icon">{% icon "chevron-down" %}</span>
        </summary>
        <div class="accordion-panel prose">
          {{ item.a | markdown | safe }}
        </div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
