<nav class="site-nav" role="navigation" aria-label="Main navigation">
  <div class="container">
    <div class="nav-inner">

      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label="Manchester LMC home">
        <img src="/assets/images/logo.svg" alt="" width="44" height="44" decoding="async">
      </a>

      <!-- Primary nav -->
      <ul class="nav-primary" role="list">
        {% for item in nav %}
        <li class="nav-item{% if item.href in page.url %} nav-item--active{% endif %}">
          <a href="{{ item.href }}" class="nav-link"{% if item.href in page.url %} aria-current="page"{% endif %}>
            {{ item.label }}
            {% if item.dropdown %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            {% endif %}
          </a>
          {% if item.dropdown %}
          <div class="nav-dropdown">
            {% for sub in item.dropdown %}
            <a href="{{ sub.href }}">{{ sub.label }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>

      <!-- Utility bar -->
      <div class="nav-utility">
        <button class="nav-search-btn" aria-label="Search site">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>
        <a href="/members/" class="nav-utility-btn nav-utility-btn--ghost">Login</a>
        <a href="/members/#register" class="nav-utility-btn nav-utility-btn--primary">Register</a>
      </div>

      <!-- Mobile search icon -->
      <button class="nav-search-btn nav-search-mobile-btn" aria-label="Search site">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Hamburger -->
      <button class="nav-hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

    </div><!-- /nav-inner -->
  </div><!-- /container -->

  <!-- Mobile nav -->
  <div class="nav-mobile" aria-hidden="true">
    <ul role="list">
      {% for item in nav %}
      <li class="nav-mobile-item">
        <a href="{{ item.href }}" class="nav-mobile-link"{% if item.dropdown %} data-toggle="{{ item.mobileId }}"{% endif %}>
          {{ item.label }}
          {% if item.dropdown %}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          {% endif %}
        </a>
        {% if item.dropdown %}
        <div class="nav-mobile-sub" id="{{ item.mobileId }}" style="display:none">
          {% for sub in item.dropdown %}
          <a href="{{ sub.href }}">{{ sub.label }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    <div class="nav-mobile-utility">
      <a href="/members/" class="btn btn--outline" style="justify-content:center">Login</a>
      <a href="/members/#register" class="btn btn--primary" style="justify-content:center">Register as a Member</a>
    </div>
  </div>

</nav><!-- /site-nav -->
