{% from "partials/icons.njk" import location, phone, email, clock %}
<div class="contact-strip">
  <div class="container">
    <div class="contact-strip-grid">

      <div class="contact-strip-item">
        <div class="contact-strip-icon">{{ location() }}</div>
        <div>
          <div class="contact-strip-label">Address</div>
          <div class="contact-strip-value">{{ site.address.line1 }}, {{ site.address.line2 }}, {{ site.address.line3 }}, {{ site.address.city }} {{ site.address.postcode }}</div>
        </div>
      </div>

      <div class="contact-strip-item">
        <div class="contact-strip-icon">{{ phone() }}</div>
        <div>
          <div class="contact-strip-label">Telephone</div>
          <div class="contact-strip-value">
            <a href="tel:{{ site.phone1 | replace(' ', '') }}">{{ site.phone1 }}</a><br>
            <a href="tel:{{ site.phone2 | replace(' ', '') }}">{{ site.phone2 }}</a>
          </div>
        </div>
      </div>

      <div class="contact-strip-item">
        <div class="contact-strip-icon">{{ email() }}</div>
        <div>
          <div class="contact-strip-label">Email</div>
          <div class="contact-strip-value">
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </div>
        </div>
      </div>

      <div class="contact-strip-item">
        <div class="contact-strip-icon">{{ clock() }}</div>
        <div>
          <div class="contact-strip-label">Office Hours</div>
          <div class="contact-strip-value">{{ site.officeHours }}</div>
        </div>
      </div>

    </div><!-- /contact-strip-grid -->
  </div>
</div>
