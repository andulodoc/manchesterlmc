<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand -->
      <div>
        <a href="/" class="footer-logo" aria-label="Manchester LMC home">
          <img src="/assets/images/logo.svg" alt="" width="140" height="42" decoding="async">
        </a>
        <p class="footer-tagline">{{ settings.site.tagline }}</p>
        <div class="footer-social">
          <a href="{{ settings.site.twitter }}" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.739l7.734-8.835L1.254 2.25H8.08l4.26 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="{{ settings.site.facebook }}" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            {% icon "facebook", 20, "fill" %}
          </a>
          <a href="{{ settings.site.linkedin }}" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            {% icon "linkedin", 20, "fill" %}
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/about/">About Manchester LMC</a></li>
          <li><a href="/support/">Support Services</a></li>
          <li><a href="/guidance/">Resource Library</a></li>
          <li><a href="/news/">News &amp; Newsletters</a></li>
          <li><a href="/events/">Events &amp; Meetings</a></li>
          <li><a href="/vacancies/">Vacancies</a></li>
          <li><a href="/support/breach-report/">Report a Breach</a></li>
          {% if showDisclaimer %}<li><a href="#" id="view-disclaimer-link" class="footer-link-secondary">View Disclaimer</a></li>{% endif %}
        </ul>
      </div>

      <!-- Support -->
      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="/support/wellbeing/">Wellbeing Hub</a></li>
          <li><a href="/support/#confidential">Confidential Advisory</a></li>
          <li><a href="/members/">Members Area</a></li>
          <li><a href="/members/#register">Register as Member</a></li>
          <li><a href="https://www.bma.org.uk" target="_blank" rel="noopener">BMA Website</a></li>
          <li><a href="https://www.cameronfund.org.uk" target="_blank" rel="noopener">Cameron Fund</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4>Contact Us</h4>
        <div class="footer-contact-item">
          {% icon "map-pin" %}
          <span>{{ settings.site.address.line1 }}, {{ settings.site.address.line2 }}, {{ settings.site.address.line3 }}, {{ settings.site.address.postcode }}</span>
        </div>
        <div class="footer-contact-item">
          {% icon "phone" %}
          <a href="tel:{{ settings.site.phone1 | replace(' ', '') }}">{{ settings.site.phone1 }}</a>
        </div>
        <div class="footer-contact-item">
          {% icon "mail" %}
          <a href="mailto:{{ settings.site.email }}">{{ settings.site.email }}</a>
        </div>
        <div style="margin-top:var(--space-5);">
          <a href="/contact/" class="btn btn--outline" style="border-color:rgba(255,255,255,0.25);color:rgba(255,255,255,0.75);font-size:0.875rem;">Contact Us</a>
        </div>
      </div>

    </div><!-- /footer-grid -->

    <div class="footer-bottom">
      <p>&copy; {{ settings.site.copyright }}</p>
      <div class="footer-bottom-links">
        <a href="/about/policies/#privacy">Privacy Policy</a>
        <a href="/about/policies/#accessibility">Accessibility</a>
        <a href="/about/policies/#cookies">Cookies</a>
        <a href="/about/policies/">Policies</a>
      </div>
    </div>

  </div><!-- /container -->
</footer>
