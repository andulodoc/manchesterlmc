<div class="profile-card">
  <div class="profile-card-photo">
    {% if person.data.photo %}
    <img src="{{ person.data.photo }}" alt="{{ person.data.title }}" width="300" height="300" loading="lazy">
    {% else %}
    <div class="profile-card-photo-placeholder" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </div>
    {% endif %}
  </div>
  <div class="profile-card-body">
    <div class="profile-card-role">{{ person.data.role }}</div>
    <div class="profile-card-name">{{ person.data.title }}</div>
    <p class="profile-card-bio">{{ person.templateContent | safe }}</p>
    {% if person.data.email %}
    <a href="mailto:{{ person.data.email }}" class="profile-card-email">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      {{ person.data.email }}
    </a>
    {% endif %}
  </div>
</div>
