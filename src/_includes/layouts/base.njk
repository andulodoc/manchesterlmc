<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ seo.metaDescription if seo.metaDescription else (description or settings.site.tagline) }}">
  <title>{% if seo.metaTitle %}{{ seo.metaTitle }}{% elif title %}{{ title }} — {{ settings.site.name }}{% else %}{{ settings.site.name }}{% endif %}</title>
  <link rel="canonical" href="{{ settings.site.url }}{{ page.url }}">
  <meta property="og:title" content="{% if seo.metaTitle %}{{ seo.metaTitle }}{% elif title %}{{ title }} — {{ settings.site.name }}{% else %}{{ settings.site.name }}{% endif %}">
  <meta property="og:description" content="{{ seo.metaDescription if seo.metaDescription else (description or settings.site.tagline) }}">
  {% if seo.ogImage %}<meta property="og:image" content="{{ settings.site.url }}{{ seo.ogImage }}">{% endif %}
  <meta property="og:type" content="{% if tags and 'news' in tags %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ settings.site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@manchesterlmc">

  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/styles.css">

  {% block head %}{% endblock %}
</head>
<body>

<a href="#main-content" class="skip-link">Skip to main content</a>

{% include "partials/nav.njk" %}

<!-- ── Main Content ────────────────────────────────────────── -->
<main id="main-content"{% if mainClass %} class="{{ mainClass }}"{% endif %}>

  {{ content | safe }}

  {% if showContactStrip %}{% include "partials/contact-strip.njk" %}{% endif %}

</main>

{% include "partials/footer.njk" %}

{% if showDisclaimer %}
<!-- Disclaimer -->
<dialog id="disclaimer-overlay" class="disclaimer-dialog" aria-labelledby="disclaimer-title" aria-describedby="disclaimer-desc">
  <div class="disclaimer-content">
<h2 id="disclaimer-title">Website Under Development</h2>
    <div class="disclaimer-text">
      <p id="disclaimer-desc">This website is currently <strong>under development</strong> and is being made available for testing and feedback purposes.</p>
      <p>Please be aware that:</p>
      <ul class="disclaimer-list">
        <li>The content and information presented on this site may be <strong>subject to change</strong>.</li>
        <li>Some features and sections may be incomplete or contain placeholder data.</li>
        <li>The official Manchester LMC website at <a href="https://www.manchesterlmc.co.uk" target="_blank" rel="noopener noreferrer">manchesterlmc.co.uk</a> should be considered the authoritative source for information.</li>
      </ul>
      <div class="disclaimer-actions">
        <button class="btn btn--primary" id="accept-disclaimer">I Understand — Continue to Site</button>
        <button class="btn btn--outline" id="view-again-disclaimer">View Official Site Instead</button>
      </div>
    </div>
  </div>
</dialog>
<!-- End Disclaimer -->
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  "name": "{{ settings.site.name }}",
  "url": "{{ settings.site.url }}",
  "description": "{{ settings.site.tagline }}",
  "telephone": "{{ settings.site.phone1 }}",
  "email": "{{ settings.site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ settings.site.address.line1 }}, {{ settings.site.address.line2 }}, {{ settings.site.address.line3 }}",
    "addressLocality": "{{ settings.site.address.city }}",
    "postalCode": "{{ settings.site.address.postcode }}",
    "addressCountry": "GB"
  },
  "sameAs": [
    "{{ settings.site.twitter }}",
    "{{ settings.site.facebook }}",
    "{{ settings.site.linkedin }}"
  ]
}
</script>

<script src="/assets/js/main.js"></script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script src="/assets/js/netlify-identity-init.js"></script>

{% block scripts %}{% endblock %}

</body>
</html>
