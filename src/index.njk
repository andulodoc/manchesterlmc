---
layout: layouts/base.njk
title: "Representing and Supporting General Practice in Manchester"
description: "Manchester LMC is the statutory representative body for approximately 500 GPs across 82 practices in Manchester."
mainClass: page-content
showDisclaimer: true
---

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">
            {% icon "circle", 14, "fill" %}
            {{ homepage.hero.eyebrow }}
          </p>
          <h1 id="hero-heading">{{ homepage.hero.heading }}</h1>
          <p class="hero-lead">{{ homepage.hero.lead }}</p>
          <div class="hero-actions">
            {% for cta in homepage.hero.ctas %}
            <a href="{{ cta.url }}" class="btn btn--{{ cta.style }} btn--lg">
              {% if cta.style === "primary" %}
              {% icon "shield", 18 %}
              {% elif cta.style === "secondary" %}
              {% icon "user", 18 %}
              {% endif %}
              {{ cta.label }}
            </a>
            {% endfor %}
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <img src="/assets/images/logo.svg" alt="" class="hero-logo-mark">
        </div>
      </div>
    </div>
  </section>

  <!-- ── Role Selector ──────────────────────────────────────── -->
  <section class="role-strip" aria-labelledby="role-heading">
    <div class="container">
      <h2 id="role-heading">I am a…</h2>
      <div class="role-cards">

        <a href="/support/#partner" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            {% icon "briefcase" %}
          </div>
          <span class="role-card-title">{{ homepage.roleCards[0].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[0].subtitle }}</span>
        </a>

        <a href="/support/#salaried" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            {% icon "user" %}
          </div>
          <span class="role-card-title">{{ homepage.roleCards[1].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[1].subtitle }}</span>
        </a>

        <a href="/support/#locum" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            {% icon "shuffle" %}
          </div>
          <span class="role-card-title">{{ homepage.roleCards[2].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[2].subtitle }}</span>
        </a>

        <a href="/support/#manager" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            {% icon "settings" %}
          </div>
          <span class="role-card-title">{{ homepage.roleCards[3].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[3].subtitle }}</span>
        </a>

        <a href="/support/#nurse" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            {% icon "heart" %}
          </div>
          <span class="role-card-title">{{ homepage.roleCards[4].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[4].subtitle }}</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Statistics ──────────────────────────────────────────── -->
  <section class="stats-banner" aria-label="Key statistics">
    <div class="container">
      <div class="stats-grid">
        {% for stat in homepage.stats %}
        <div class="stat-item">
          <div class="stat-number">{{ stat.number }}</div>
          <div class="stat-label">{{ stat.label }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ── Latest News ─────────────────────────────────────────── -->
  <section class="section" aria-labelledby="news-heading">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <span class="section-eyebrow">Stay Informed</span>
          <h2 id="news-heading">Latest News</h2>
        </div>
        <a href="/news/" class="link-arrow">
          All News
          {% icon "arrow-right" %}
        </a>
      </div>

      <div class="grid-3" role="list">
        {% for article in collections.featuredNews | limit(3) %}
          {% include "partials/news-card.njk" %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ── Upcoming Events ─────────────────────────────────────── -->
  <section class="section section--neutral" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <span class="section-eyebrow">Your Calendar</span>
          <h2 id="events-heading">Upcoming Events</h2>
        </div>
        <a href="/events/" class="link-arrow">
          Full Calendar
          {% icon "arrow-right" %}
        </a>
      </div>

      <div class="events-list">
        {% for event in collections.upcomingEvents | limit(3) %}
        <div class="event-item">
          <div class="event-date-badge">
            <span class="event-date-day">{{ event.date | dateDay }}</span>
            <span class="event-date-month">{{ event.date | dateMonthShort }}</span>
          </div>
          <div class="event-content">
            <h4><a href="/events/">{{ event.data.title }}</a></h4>
            <div class="event-meta">
              {% if event.data.time %}
              <span class="event-meta-item">
                {% icon "clock", 16 %}
                {{ event.data.time }}
              </span>
              {% endif %}
              {% if event.data.venue %}
              <span class="event-meta-item">
                {% if event.data.format === "online" %}
                {% icon "monitor", 16 %}
                {% else %}
                {% icon "map-pin", 16 %}
                {% endif %}
                {{ event.data.venue }}
              </span>
              {% endif %}
            </div>
            {% if event.data.description %}<p class="event-desc">{{ event.data.description }}</p>{% endif %}
          </div>
          {% if event.data.registerUrl %}
          <a href="{{ event.data.registerUrl }}" class="btn btn--outline btn--sm event-register-btn">{{ event.data.registerLabel or "Register" }}</a>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ── Services Grid ───────────────────────────────────────── -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="section-eyebrow">What We Offer</span>
        <h2 id="services-heading">How Manchester LMC Supports You</h2>
        <p>From expert guidance to confidential support, we're here every step of the way.</p>
      </div>

      <div class="grid-3">

        <a href="/guidance/" class="service-card">
          <div class="service-card-icon">
            {% icon "file-text" %}
          </div>
          <h3>{{ homepage.serviceCards[0].title }}</h3>
          <p>{{ homepage.serviceCards[0].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[0].linkText }}
            {% icon "arrow-right" %}
          </span>
        </a>

        <a href="/support/" class="service-card">
          <div class="service-card-icon">
            {% icon "shield" %}
          </div>
          <h3>{{ homepage.serviceCards[1].title }}</h3>
          <p>{{ homepage.serviceCards[1].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[1].linkText }}
            {% icon "arrow-right" %}
          </span>
        </a>

        <a href="/support/wellbeing/" class="service-card">
          <div class="service-card-icon">
            {% icon "heart" %}
          </div>
          <h3>{{ homepage.serviceCards[2].title }}</h3>
          <p>{{ homepage.serviceCards[2].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[2].linkText }}
            {% icon "arrow-right" %}
          </span>
        </a>

        <a href="/vacancies/" class="service-card">
          <div class="service-card-icon">
            {% icon "user-plus" %}
          </div>
          <h3>{{ homepage.serviceCards[3].title }}</h3>
          <p>{{ homepage.serviceCards[3].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[3].linkText }}
            {% icon "arrow-right" %}
          </span>
        </a>

        <a href="/events/" class="service-card">
          <div class="service-card-icon">
            {% icon "calendar" %}
          </div>
          <h3>{{ homepage.serviceCards[4].title }}</h3>
          <p>{{ homepage.serviceCards[4].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[4].linkText }}
            {% icon "arrow-right" %}
          </span>
        </a>

        <a href="/members/" class="service-card">
          <div class="service-card-icon">
            {% icon "award" %}
          </div>
          <h3>{{ homepage.serviceCards[5].title }}</h3>
          <p>{{ homepage.serviceCards[5].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[5].linkText }}
            {% icon "arrow-right" %}
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Latest Newsletter ───────────────────────────────────── -->
  <section class="section section--neutral" aria-labelledby="newsletter-heading">
    <div class="container">
      <div class="newsletter-card">
        <div class="newsletter-card-body">
          <p class="newsletter-card-eyebrow">Newsletter</p>
          <h3 id="newsletter-heading">{{ homepage.newsletter.title }}</h3>
          <p>{{ homepage.newsletter.description }}</p>
          <div class="newsletter-actions">
            {% if homepage.newsletter.downloadUrl %}
            <a href="{{ homepage.newsletter.downloadUrl }}" class="btn btn--secondary">Download Issue (PDF)</a>
            {% endif %}
            {% if homepage.newsletter.archiveUrl %}
            <a href="{{ homepage.newsletter.archiveUrl }}" class="btn btn--secondary">View Archive</a>
            {% endif %}
          </div>
        </div>
        <div class="newsletter-card-download">
          <div class="newsletter-icon">
            {% icon "download" %}
          </div>
          <span class="newsletter-issue-label">{{ homepage.newsletter.issueLabel }}</span>
        </div>
      </div>
    </div>
  </section>

