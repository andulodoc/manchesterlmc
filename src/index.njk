---
layout: layouts/base.njk
title: "Representing and Supporting General Practice in Manchester"
description: "Manchester LMC is the statutory representative body for approximately 400 GPs across 87 practices in Manchester."
mainClass: page-content
showContactStrip: true
showDisclaimer: true
---

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
            {{ homepage.hero.eyebrow }}
          </p>
          <h1 id="hero-heading">{{ homepage.hero.heading }}</h1>
          <p class="hero-lead">{{ homepage.hero.lead }}</p>
          <div class="hero-actions">
            {% for cta in homepage.hero.ctas %}
            <a href="{{ cta.url }}" class="btn btn--{{ cta.style }} btn--lg">
              {% if cta.style === "primary" %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18H6.6a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.51 8.69a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 15.92z"/></svg>
              {% elif cta.style === "secondary" %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {% endif %}
              {{ cta.label }}
            </a>
            {% endfor %}
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <img src="/assets/images/logo.svg" alt="" class="hero-logo-mark">
        </div>
      </div>
    </div>
  </section>

  <!-- ── Role Selector ──────────────────────────────────────── -->
  <section class="role-strip" aria-labelledby="role-heading">
    <div class="container">
      <h2 id="role-heading">I am a…</h2>
      <div class="role-cards">

        <a href="/support/#partner" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <span class="role-card-title">{{ homepage.roleCards[0].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[0].subtitle }}</span>
        </a>

        <a href="/support/#salaried" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <span class="role-card-title">{{ homepage.roleCards[1].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[1].subtitle }}</span>
        </a>

        <a href="/support/#locum" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </div>
          <span class="role-card-title">{{ homepage.roleCards[2].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[2].subtitle }}</span>
        </a>

        <a href="/support/#manager" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <span class="role-card-title">{{ homepage.roleCards[3].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[3].subtitle }}</span>
        </a>

        <a href="/support/#nurse" class="role-card">
          <div class="role-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/><line x1="12" y1="9" x2="12" y2="15"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
          </div>
          <span class="role-card-title">{{ homepage.roleCards[4].title }}</span>
          <span class="role-card-sub">{{ homepage.roleCards[4].subtitle }}</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Statistics ──────────────────────────────────────────── -->
  <section class="stats-banner" aria-label="Key statistics">
    <div class="container">
      <div class="stats-grid">
        {% for stat in homepage.stats %}
        <div class="stat-item">
          <div class="stat-number">{{ stat.number }}</div>
          <div class="stat-label">{{ stat.label }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ── Latest News ─────────────────────────────────────────── -->
  <section class="section" aria-labelledby="news-heading">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <span class="section-eyebrow">Stay Informed</span>
          <h2 id="news-heading">Latest News</h2>
        </div>
        <a href="/news/" class="link-arrow">
          All News
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="grid-3" role="list">
        {% for article in collections.featuredNews | limit(3) %}
          {% include "partials/news-card.njk" %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ── Upcoming Events ─────────────────────────────────────── -->
  <section class="section section--neutral" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-header flex-between">
        <div>
          <span class="section-eyebrow">Your Calendar</span>
          <h2 id="events-heading">Upcoming Events</h2>
        </div>
        <a href="/events/" class="link-arrow">
          Full Calendar
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="events-list">
        {% for event in collections.upcomingEvents | limit(3) %}
        <div class="event-item">
          <div class="event-date-badge">
            <span class="event-date-day">{{ event.date | dateDay }}</span>
            <span class="event-date-month">{{ event.date | dateMonthShort }}</span>
          </div>
          <div class="event-content">
            <h4><a href="/events/">{{ event.data.title }}</a></h4>
            <div class="event-meta">
              {% if event.data.time %}
              <span class="event-meta-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ event.data.time }}
              </span>
              {% endif %}
              {% if event.data.venue %}
              <span class="event-meta-item">
                {% if event.data.format === "online" %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {% endif %}
                {{ event.data.venue }}
              </span>
              {% endif %}
            </div>
            {% if event.data.description %}<p class="event-desc">{{ event.data.description }}</p>{% endif %}
          </div>
          {% if event.data.registerUrl %}
          <a href="{{ event.data.registerUrl }}" class="btn btn--outline btn--sm event-register-btn">{{ event.data.registerLabel or "Register" }}</a>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ── Services Grid ───────────────────────────────────────── -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="section-eyebrow">What We Offer</span>
        <h2 id="services-heading">How Manchester LMC Supports You</h2>
        <p>From expert guidance to confidential support, we're here every step of the way.</p>
      </div>

      <div class="grid-3">

        <a href="/guidance/" class="service-card">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3>{{ homepage.serviceCards[0].title }}</h3>
          <p>{{ homepage.serviceCards[0].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[0].linkText }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>

        <a href="/support/" class="service-card">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <h3>{{ homepage.serviceCards[1].title }}</h3>
          <p>{{ homepage.serviceCards[1].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[1].linkText }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>

        <a href="/support/wellbeing/" class="service-card">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z"/><path d="M12 5l-1 1 2 4-3 1 4 5"/></svg>
          </div>
          <h3>{{ homepage.serviceCards[2].title }}</h3>
          <p>{{ homepage.serviceCards[2].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[2].linkText }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>

        <a href="/vacancies/" class="service-card">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
          </div>
          <h3>{{ homepage.serviceCards[3].title }}</h3>
          <p>{{ homepage.serviceCards[3].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[3].linkText }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>

        <a href="/events/" class="service-card">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 14 15 18"/></svg>
          </div>
          <h3>{{ homepage.serviceCards[4].title }}</h3>
          <p>{{ homepage.serviceCards[4].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[4].linkText }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>

        <a href="/members/" class="service-card">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
          </div>
          <h3>{{ homepage.serviceCards[5].title }}</h3>
          <p>{{ homepage.serviceCards[5].text }}</p>
          <span class="service-card-link">{{ homepage.serviceCards[5].linkText }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Latest Newsletter ───────────────────────────────────── -->
  <section class="section section--neutral" aria-labelledby="newsletter-heading">
    <div class="container">
      <div class="newsletter-card">
        <div class="newsletter-card-body">
          <p class="newsletter-card-eyebrow">Newsletter</p>
          <h3 id="newsletter-heading">{{ homepage.newsletter.title }}</h3>
          <p>{{ homepage.newsletter.description }}</p>
          <div class="newsletter-actions">
            {% if homepage.newsletter.downloadUrl %}
            <a href="{{ homepage.newsletter.downloadUrl }}" class="btn btn--secondary">Download Issue (PDF)</a>
            {% endif %}
            {% if homepage.newsletter.archiveUrl %}
            <a href="{{ homepage.newsletter.archiveUrl }}" class="btn btn--secondary">View Archive</a>
            {% endif %}
          </div>
        </div>
        <div class="newsletter-card-download">
          <div class="newsletter-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
          </div>
          <span class="newsletter-issue-label">{{ homepage.newsletter.issueLabel }}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Twitter / Social embed area ────────────────────────── -->
  <section class="section" aria-labelledby="social-heading">
    <div class="container">
      <div class="section-header section-header--center section-header--compact">
        <span class="section-eyebrow">Social</span>
        <h2 id="social-heading">Follow Us on X (Twitter)</h2>
      </div>
      <div class="social-embed-placeholder">
        <div class="social-embed-box">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.739l7.734-8.835L1.254 2.25H8.08l4.26 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <p>Latest tweets from <strong>@ManchesterLMC</strong></p>
          <a href="{{ settings.site.twitter }}" class="btn btn--outline" target="_blank" rel="noopener noreferrer">View on X / Twitter</a>
        </div>
      </div>
    </div>
  </section>
