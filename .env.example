# ── Supabase ─────────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — found in Supabase dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Session ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=generate-a-random-64-char-hex-string

# ── hCaptcha (displayed after rate limit threshold) ──────────
# Register at hcaptcha.com — free tier available
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# ── SMTP (configure in Supabase dashboard, not here) ─────────
# Supabase → Project Settings → Auth → SMTP Settings
# Recommended providers: Postmark, Resend (both have free tiers)
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=your-api-token
# SMTP_PASS=your-api-token
# SMTP_FROM=noreply@manchesterlmc.co.uk
